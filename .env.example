# ==========================================
# GitHub Digest AI Agent - Environment Config
# ==========================================

# 1. Google Gemini API Key (Required for AI narrative summaries)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=""

# Optional: Override the Gemini model (default: gemini-2.5-flash)
# Options include: gemini-2.5-flash, gemini-1.5-flash
GEMINI_MODEL="gemini-2.5-flash"

# 2. GitHub Personal Access Token (Optional, but recommended)
# Increases rate limits from 60 to 5,000 requests/hr
# Generate at: https://github.com/settings/tokens (public_repo scope)
GITHUB_TOKEN=""

# 3. SMTP Email Configuration (Required only if emailing digests)
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SENDER_EMAIL=""
SENDER_PASSWORD=""

# Optional SMTP Host & Port (defaults to Gmail SSL on port 465)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465

# 4. Default Automation Settings
# Used when triggering automated digests via /trigger-daily-digest
DEFAULT_REPO="pallets/flask"
DEFAULT_RECIPIENT_EMAIL=""
